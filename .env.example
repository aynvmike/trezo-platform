# =====================================================================
# TREZO — Environment Variables (TEMPLATE)
# This file is safe to commit — it contains PLACEHOLDERS ONLY.
# Real keys go in these git-ignored files:
#   web/.env.local   (Next.js dashboard)
#   api/.env         (API gateway)
#   agents/.env      (Python engine — read by pydantic via
#                     agents/app/config.py, NOT by bare os.getenv;
#                     a key that only the engine reads must be here)
# Never put a real key or secret in this file.
#
# Refreshed 2026-09-01 (audit finding LIVE-6 / Phase 0: this file was
# 41 key names behind the live .env files and its Alpaca-live block was
# cut off mid-word). Every key below is one that agents/app/config.py
# declares or one of the three .env files carries. Names only.
# =====================================================================

# ---- Service (agents) ----
ENV=development
LOG_LEVEL=INFO
PORT=8001

# ---- Supabase (auth + database) ----
# web + api use the NEXT_PUBLIC_* pair; the engine uses SUPABASE_URL +
# the service-role key. On the WEB SERVER the service-role key is read
# only by web/src/lib/supabase/admin.ts, for the two machine routes
# (/api/internal/broker-token, /api/cron/refresh-broker-tokens) --
# AUTH-01/02, 2026-09-01. It is never shipped to the browser.
# (Reviewer fix R-ENV-1: the previous comment said the web tier holds
# NO service-role key, which stopped being true in the same wave.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Redis (Upstash) — shared by web, api, agents ----
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- Anthropic (agents + web sentiment) ----
ANTHROPIC_API_KEY=sk-ant-your-key

# ---- Market data ----
FINNHUB_API_KEY=your-finnhub-key
# Macro backends (optional; the picker falls through in order):
NASDAQ_DATA_LINK_API_KEY=            # US Treasury curve
TWELVE_DATA_API_KEY=                 # VIX + yields (free 800 req/day); also the forex adapter
ALPHA_VANTAGE_API_KEY=               # VIX + yields + Fed Funds (free 25 req/day)
MASSIVE_API_KEY=                     # massive.com (stub backend today)
# Manual macro override — type the current values; blank = not set.
TREZO_MACRO_VIX=
TREZO_MACRO_YIELD_SPREAD=
TREZO_MACRO_FED_FUNDS=
# CoinGecko: no key needed (public endpoints)

# ---- Alpaca PAPER — primary account ----
# Create a free paper account at alpaca.markets.
ALPACA_API_KEY=PKYOUR-paper-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Pin the account number the engine must bind to (startup self-check
# raises an ops alert on mismatch). Blank = no pin.
ALPACA_EXPECTED_ACCOUNT=
# Route crypto through Alpaca paper crypto (default off = modeled engine).
ALPACA_CRYPTO_ENABLED=false

# ---- Multi-account (2026-08-09) ----
# One OWNER (a person), many ACCOUNTS (books). Only credentials live
# here; behaviour lives in each book's bot_settings row.
# Which slots are on: "primary" alone (safe default) or "primary,acct2,acct3".
TREZO_ACCOUNTS_ENABLED=primary
# The book that is THE default target: primary|acct2|acct3.
TREZO_DEFAULT_ACCOUNT=primary
# Person who owns the books (auth.users id). Blank = primary user id.
TREZO_OWNER_ID=
# Primary book's user_id (also the signal user). Read via Settings only.
TREZO_PRIMARY_USER_ID=
# One bot_settings row for everything (true) or per-book rows (false).
TREZO_SETTINGS_SINGLE_ROW=true
# Autorepair mis-routed strays back to the book that holds them (detection
# is always on; repair is a decision, default off).
TREZO_ROUTE_AUTOREPAIR=false
# Slot 2 — must match a trading_accounts.account_key (migration 0045).
ALPACA_API_KEY_2=
ALPACA_SECRET_KEY_2=
ALPACA_BASE_URL_2=https://paper-api.alpaca.markets
TREZO_ACCOUNT_USER_ID_2=
TREZO_ACCOUNT_LABEL_2=Account 2
TREZO_ACCOUNT_OWNER_ID_2=
TREZO_DIVLT_TARGET_2=0               # dividend-lane initial deployment target, USD (0 = full pocket)
# Slot 3
ALPACA_API_KEY_3=
ALPACA_SECRET_KEY_3=
ALPACA_BASE_URL_3=https://paper-api.alpaca.markets
TREZO_ACCOUNT_USER_ID_3=
TREZO_ACCOUNT_LABEL_3=Account 3
TREZO_ACCOUNT_OWNER_ID_3=
TREZO_DIVLT_TARGET_3=0

# ---- Crypto exchange connector (Coinbase / Kraken) — scaffold, OFF ----
CRYPTO_EXCHANGE_ENABLED=false
CRYPTO_EXCHANGE=coinbase             # coinbase | kraken
CRYPTO_EXCHANGE_API_KEY=
CRYPTO_EXCHANGE_API_SECRET=
# Kraken spot creds (pydantic is case-insensitive: Kraken_API_KEY works too).
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
# Kraken FUTURES (demo first; separate demo key from demo-futures.kraken.com).
KRAKEN_FUTURES_ENABLED=false
KRAKEN_FUTURES_DEMO=true
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=
FUTURES_MAX_LEVERAGE=10.0

# ---- Engine behaviour knobs (agents/.env; all have code defaults) ----
TREZO_BROKER_ONLY=true               # only trade what Alpaca can execute
TREZO_FOREX_MODELED_OK=false         # allow modeled forex under broker-only
FOREX_ENABLED=false                  # forex lane; OFF is Mike's choice
TREZO_CRYPTO_TCS_FLOOR=35
TREZO_WHEEL_MAX_DTE=0                # 0 = posture default
TREZO_VOL_ESTIMATOR=yang_zhang       # garman_klass | rogers_satchell | parkinson | close_to_close
TREZO_LIBRARY_MAX_MB=40              # largest drop-box file the library reads
MAX_POSITION_PCT=0.25                # per-position concentration cap (fraction of equity)
MIN_REWARD_RISK_FLOOR=1.5            # seed default; live floor is per-book bot_settings.min_reward_risk
MAX_OPEN_SIGNALS=20
MIN_AVG_VOLUME=250000                # 20-day average share volume floor
OUTCOME_GATE_TUNING_ENABLED=false    # experience-driven TCS floor nudges (opt-in)
AUTO_EXIT_ADVISOR=false              # advisor acts (close/trim) instead of alerting
SKIP_SIGNAL_PERSIST=true             # keep 'signal' messages off Supabase
# Options Greek-aware filters
OPTIONS_MIN_DTE=7
OPTIONS_MAX_PREMIUM_DELTA=0.45
OPTIONS_MIN_IV_RANK_SCALP=30.0
OPTIONS_HOPEFUL_ALLOCATION_CAP_PCT=0.03
# Continuous re-evaluation engine (master off; sub-actions on except average-down)
TREZO_REEVAL_ENABLED=false
TREZO_REEVAL_TIGHTEN_STOP=true
TREZO_REEVAL_LOWER_TARGET=true
TREZO_REEVAL_ROTATE=true
TREZO_REEVAL_AVERAGE_DOWN=false
# Coverage mode (read via os.getenv in the engine; present in agents/.env)
TREZO_COVERAGE_MODE=
TREZO_COVERAGE_TCS=
TREZO_COVERAGE_TRADE_USD=

# ---- Mem0 hosted memory (blank = agents run without memory) ----
MEM0_API_KEY=
MEM0_MAX_ADDS_PER_DAY=400
MEM0_MAX_ADDS_PER_WEEK=2500
MEM0_MAX_SEARCHES_PER_DAY=2000

# ---- App config / service-to-service ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
AGENTS_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
# Engine -> web callback for /api/cron/refresh-broker-tokens (both required
# for the poller to run; otherwise it logs once and skips).
TREZO_WEB_BASE_URL=
CRON_SECRET=
# Shared secret for engine <-> web machine-to-machine calls. Set on BOTH
# sides or the engine stays in legacy env-key mode (audit §2.13).
AGENTS_SHARED_SECRET=
# Reviewer fix R-ENV-2 (2026-09-01): the four web-side keys the
# AUTH-01/02/ADM-01 wave depends on were missing from this template
# although web/.env.local carries them. Names only.
# Engine -> web origin for the per-user broker-token read
# (agents/app/integrations/web_tokens.py; falls back to
# NEXT_PUBLIC_BASE_URL, then http://localhost:3000).
WEB_INTERNAL_BASE_URL=
# Public origin of the web service (OAuth redirect_uri). web/.env.local.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated auth.users ids allowed on /api/admin/* and the agent
# toggle/trigger/run-now, reconcile, place-leg and lab/teach routes.
# Blank = every one of those routes returns 403 (fails closed).
TREZO_OWNER_USER_IDS=
# 64-char hex key that encrypts stored broker OAuth tokens
# (web/.env.local). Without it /api/brokers/*/authorize returns 500.
TREZO_TOKENS_KEY=

# ---- Encryption (Fernet, base64-urlsafe 32 bytes) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=replace-with-fernet.generate_key()-output

# ---- JWT signing (API gateway) ----
JWT_SECRET=replace-with-32-byte-random-hex

# ---- Trading mode (Phase 10) ----
# Master switch for the execution path.
#   paper = simulated trades, no real money. The default, and the only
#           supported mode today.
#   live  = reserved for Phase 10 (real-money brokerage). Inert until the
#           live executor is built and reviewed — setting it alone does
#           nothing. Do not set this to "live" until the go-live checklist
#           (GO_LIVE_CHECKLIST.md) is fully complete.
# Goes in agents/.env and web/.env.local. Missing = treated as paper.
TRADING_MODE=paper

# ---- Alpaca LIVE keys (Phase 10b — leave blank) ----
# Only used when the live executor is enabled AND TRADING_MODE=live.
# These are separate from the paper keys above. Leave blank until the
# go-live checklist (GO_LIVE_CHECKLIST.md) is complete and Mike has
# signed off. The live executor does not exist yet; with these blank
# nothing in the engine can reach a live account. (Block restored
# 2026-09-01 — it had been truncated mid-word; audit LIVE-6.)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# ---- Outbound alerts (2026-08-18) ------------------------------------
# The channel the platform did not have. Without it every alert the
# engine raises lands in a table nobody reads -- which is how five days
# of unmanaged positions and a 15-hour outage both went unnoticed.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
# Slack:   api.slack.com/messaging/webhooks
# Unset = silent no-op; nothing breaks, you just do not get told.
# Lives in agents/.env (Settings.trezo_alert_webhook).
TREZO_ALERT_WEBHOOK=
# Any unmanaged position is a fault; above this dollar value it is urgent.
TREZO_HEALTH_URGENT_USD=1000

# ---- Archive (2026-08-18) --------------------------------------------
# Nothing should exist only on the server. Hourly bundle -> Supabase
# Storage (no new credential needed); weekly -> Dropbox, a different
# vendor on purpose.
TREZO_ARCHIVE_ENABLED=1
TREZO_ARCHIVE_BUCKET=trezo-archive
TREZO_REPO_DIR=C:\Trezo\trezo-platform
# Dropbox: app console -> your app -> Permissions: files.content.write.
# Use the REFRESH token flow -- raw access tokens expire after 4 hours,
# which is a backup that looks fine until the day you need it.
TREZO_DROPBOX_APP_KEY=
TREZO_DROPBOX_APP_SECRET=
TREZO_DROPBOX_REFRESH_TOKEN=

# ---- Tooling (present in agents/.env; not read by the engine) ----
GITHUB_PUSH_TOKEN=                   # AUTO-PUSH / SYNC-PUSH scripts
FIGMA_API_KEY=                       # design tooling only
